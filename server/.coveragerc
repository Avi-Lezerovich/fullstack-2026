# Whole-package coverage. The previous version of this project excluded every
# function it had not tested by name, which made the percentage meaningless.
# Here the only omissions are process entry points, which contain a run loop
# and nothing worth asserting.

[run]
source = app,worker
branch = False
omit =
    */run.py
    */run_worker.py
    */tests/*

[report]
fail_under = 85
show_missing = True
skip_covered = False
exclude_also =
    if __name__ == .__main__.:
    raise NotImplementedError
    if TYPE_CHECKING:
    \.\.\.
