# =============================================================================
#  LolSuit frontend - static bundle + API reverse proxy
# =============================================================================
#  Serving the bundle and proxying /api from the SAME origin is a deliberate
#  choice, not a convenience. It means:
#    * the httpOnly session cookie is first-party, so it survives without
#      SameSite=None (which would require HTTPS everywhere, including locally);
#    * flask-cors never has to answer a preflight, and CLIENT_ORIGIN stops
#      being a thing that can be wrong;
#    * the client's `const BASE = "/api"` works unchanged in dev and in prod.
# =============================================================================

# Unprivileged: nginx runs as uid 1001, which cannot bind :80 or write the
# default /var/run/nginx.pid, so both are relocated below.
pid /tmp/nginx.pid;

worker_processes auto;

events {
  worker_connections 1024;
}

http {
  include       /etc/nginx/mime.types;
  default_type  application/octet-stream;

  # Every path nginx writes to must live somewhere the unprivileged user owns.
  client_body_temp_path /tmp/client_body;
  proxy_temp_path       /tmp/proxy;
  fastcgi_temp_path     /tmp/fastcgi;
  uwsgi_temp_path       /tmp/uwsgi;
  scgi_temp_path        /tmp/scgi;

  sendfile      on;
  tcp_nopush    on;
  server_tokens off;

  # Logs to the container's stdout/stderr, so `docker compose logs` is the one
  # place to look and nothing accumulates on a writable layer.
  access_log /dev/stdout;
  error_log  /dev/stderr warn;

  gzip              on;
  gzip_vary         on;
  gzip_min_length   1024;
  gzip_proxied      any;
  gzip_types        text/plain text/css application/javascript application/json
                    image/svg+xml application/xml;

  # The API's own hostname is resolved at startup from $API_UPSTREAM, which
  # docker-entrypoint's envsubst fills in (see the Dockerfile).
  upstream api {
    server ${API_UPSTREAM};
    keepalive 16;
  }

  server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # --- the live notification stream ---------------------------------------
    # SSE before the generic /api rule, because it needs the opposite of the
    # usual proxy defaults: buffering off (otherwise nginx holds each event
    # until its buffer fills and the UI updates in bursts), and a read timeout
    # longer than SSE_MAX_SECONDS so nginx never severs a healthy stream.
    location = /api/notifications/stream {
      proxy_pass         http://api;
      proxy_http_version 1.1;
      proxy_set_header   Connection "";
      proxy_set_header   Host              $host;
      proxy_set_header   X-Real-IP         $remote_addr;
      proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header   X-Forwarded-Proto $scheme;

      proxy_buffering    off;
      proxy_cache        off;
      chunked_transfer_encoding off;
      proxy_read_timeout 3600s;
      proxy_send_timeout 3600s;
    }

    # --- image uploads -------------------------------------------------------
    # nginx's default client_max_body_size is 1m, which would 413 every upload
    # before it ever reached Flask. Raised here only, so the cap stays tight on
    # every other endpoint - none of which has any reason to accept a body
    # this large.
    location = /api/uploads {
      client_max_body_size 6m;

      proxy_pass         http://api;
      proxy_http_version 1.1;
      proxy_set_header   Connection "";
      proxy_set_header   Host              $host;
      proxy_set_header   X-Real-IP         $remote_addr;
      proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header   X-Forwarded-Proto $scheme;

      proxy_request_buffering on;
      proxy_read_timeout 120s;
      proxy_send_timeout 120s;
    }

    # --- everything else the app fetches ------------------------------------
    location /api/ {
      proxy_pass         http://api;
      proxy_http_version 1.1;
      proxy_set_header   Connection "";
      proxy_set_header   Host              $host;
      proxy_set_header   X-Real-IP         $remote_addr;
      proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header   X-Forwarded-Proto $scheme;

      proxy_connect_timeout 5s;
      proxy_read_timeout    60s;
    }

    # --- the bundle ----------------------------------------------------------
    # Vite fingerprints these filenames, so a year of immutable caching is safe
    # and a new deploy simply requests different names.
    location /assets/ {
      expires 1y;
      add_header Cache-Control "public, immutable";
      try_files $uri =404;
    }

    # index.html itself must never be cached, or browsers keep asking for the
    # asset filenames from the previous deploy.
    location = /index.html {
      add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # The app uses BrowserRouter, so /users and /case/3 are client-side routes
    # with no file behind them. Everything unmatched falls through to the SPA.
    location / {
      try_files $uri $uri/ /index.html;
    }
  }
}
