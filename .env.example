# =============================================================================
#  LolSuit configuration template
# =============================================================================
#  `docker compose up --build` works with NO .env at all - every variable below
#  falls back to a working local default (see docker-compose.yml). Copy this
#  file to .env only when you want to change something:
#
#      cp .env.example .env
#
#  .env is gitignored. Never commit real credentials, and never bake them into
#  a Dockerfile - a value in an image layer is readable by anyone who can pull
#  the image. On AWS these come from the EC2 instance's .env file or from
#  Secrets Manager; see prod/README.md and prod/.env.example.
#
#  This is the set worth changing, not the whole set. server/app/config.py is
#  the exhaustive list - it holds the tuning knobs (worker tick cadences, SSE
#  timings, BCRYPT_ROUNDS, JURY_SEED_SALT) that have a right answer already.
#  Note also that DB_HOST, DB_PORT and PORT are pinned by docker-compose.yml
#  and cannot be overridden from here; they apply to a local run without Docker.
# =============================================================================

# --- database ----------------------------------------------------------------
# Locally these configure the `db` container AND how the app connects to it, so
# changing DB_PASSWORD here is enough. Against Amazon RDS, set DB_HOST to the
# instance endpoint and leave the `db` service out of the deployment.
DB_NAME=lolsuit
DB_USER=lolsuit
DB_PASSWORD=lolsuit-dev
# Only the local MySQL container uses this; the app never connects as root.
MYSQL_ROOT_PASSWORD=lolsuit-root-dev

# --- published ports ----------------------------------------------------------
# The frontend. This is the URL you open: http://localhost:8080
WEB_PUBLISH_PORT=8080
# The API and the database are published to 127.0.0.1 only, for curl, Postman
# and the pytest suite. Nothing in normal use talks to them directly.
API_PUBLISH_PORT=5002
DB_PUBLISH_PORT=3307

# --- web ----------------------------------------------------------------------
# Only used when something calls the API directly instead of through nginx.
# Through nginx every request is same-origin and CORS never applies.
CLIENT_ORIGIN=http://localhost:8080
# 1 marks the session cookie Secure + SameSite=None. Required behind HTTPS,
# and it BREAKS plain-HTTP local development, so it stays 0 here.
FLASK_SESSION_SECURE=0

# --- trial timing -------------------------------------------------------------
# Minutes per trial phase. 1440 is a day, which is the product behaviour; drop
# it to 2 if you want to watch a lawsuit reach a verdict while you wait.
PHASE_MINUTES=1440
# How often the worker wakes up.
TICK_SECONDS=15

# --- image uploads ------------------------------------------------------------
# Where uploaded avatars and evidence photos are written. In compose this is
# overridden to /app/uploads, which is a named volume, so images survive
# `up --build`. Locally it defaults to server/uploads/.
# UPLOAD_DIR=
# Per-file cap in bytes (default 5 MB). Raising it also means raising
# client_max_body_size in client/nginx.conf.template, which rejects the body
# before it ever reaches the API.
# UPLOAD_MAX_BYTES=5242880

# --- the bots' brain ----------------------------------------------------------
# ALL OPTIONAL. With BRAIN_FORCE_OFFLINE=1 the app runs entirely on the
# deterministic offline generator: no credentials, no network, fully functional.
# That is the default, and it is what the compose stack ships with.
BRAIN_FORCE_OFFLINE=1

# To use a real model instead, set BRAIN_FORCE_OFFLINE=0 and pick a provider.
#
#   bedrock  - credentials come from the standard AWS chain (an EC2 instance
#              role is the right answer in production; never paste keys here).
#              AWS_REGION is the one thing the SDK cannot infer.
# LLM_PROVIDER=bedrock
# AWS_REGION=eu-central-1
#
#   anthropic - the direct API. LLM_API_KEY is a secret: on AWS keep it in
#               Secrets Manager and inject it at container start.
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
#
#   gemini    - Google's API. One key, no region, no SDK, and it enforces a
#               JSON schema - so unlike the gateway provider, bot filings and
#               juror votes work. The free tier is per MODEL and per Google
#               Cloud PROJECT (not per key - more keys in one project buy
#               nothing): ~1,000 requests/day on gemini-2.5-flash-lite, and
#               an unpublished allowance measured in tens on the newest Flash
#               models. Leave LLM_MODEL empty to get the sane default.
# LLM_PROVIDER=gemini
# LLM_API_KEY=

# --- more than one key: the credential chain --------------------------------
#
# Everything above describes ONE credential. Set LLM_CREDENTIALS instead and
# the brain works down a list of them, moving to the next when one is
# exhausted or failing. Records are separated by ';', fields within a record
# by ','. Order is preference order.
#
#   provider   required: bedrock | anthropic | gemini | gateway
#   label      what the dashboard groups by. Defaults to api{n}-{provider}
#   key_env    the NAME of the variable holding the key (preferred)
#   key        the key itself (fine for local hacking, not for a server)
#   model      empty means the provider's default
#   endpoint   the gateway provider only
#   region     the bedrock provider only
#   cap        daily budget. 0 or absent means "allowance unknown"
#   rpm        requests-per-minute budget. 0 or absent means "unpaced"
#
# Set rpm on a free-tier key even when its daily cap is generous. Google
# publishes a per-day allowance AND a much tighter per-minute one, and a
# worker tick that fires several jurors in a few seconds can blow the minute
# limit while the day's allowance still has thousands of calls left in it. A
# credential at its rpm is skipped in favour of the next one in the chain for
# the rest of that one-minute window, not written off for the day.
#
# Before assuming a second Gemini key doubles anything: Google's free tier is
# per Google Cloud PROJECT, not per API key. Two keys in one project share one
# allowance. Distinct projects have distinct allowances, but Google's terms
# forbid creating or rotating projects to evade a quota - so the credentials
# here should be ones that exist for their own reasons.
#
# LLM_CREDENTIALS=provider=gemini,label=api1-gemini,key_env=GEMINI_KEY_1,model=gemini-2.5-flash-lite,cap=1000,rpm=10;provider=gemini,label=api2-gemini,key_env=GEMINI_KEY_2,cap=1000,rpm=10;provider=bedrock,label=api3-bedrock,region=eu-central-1,cap=100
# GEMINI_KEY_1=
# GEMINI_KEY_2=

# Empty means the provider's default model (see server/app/brain/llm.py).
# The Claude providers default to Opus 5; gemini defaults to
# gemini-2.5-flash-lite, which is the one with a free tier worth having.
# To trade some quality for cost: LLM_MODEL=anthropic.claude-sonnet-5 (bedrock)
# or claude-sonnet-5 (direct). Setting a 2.x gemini model here is supported -
# the thinking dial is a 3.x field and is omitted for them automatically.
# LLM_MODEL=

# What the bots may treat as "current" when they file a topical lawsuit.
# Comma-separated, and deliberately operator-set rather than scraped: a human
# decides what the court riffs on, so no real named person can end up as a
# defendant by accident. The season, the weekday and the hour come from the
# clock for free and need nothing here.
#
# TOPICAL_SUBJECTS=הגשם שהגיע מוקדם השנה,שביתת הרכבת,הבחינות של סוף הסמסטר

# --- password-reset email -----------------------------------------------------
# Leave this alone and the reset link is PRINTED to the server log instead of
# being sent - `docker compose logs server` shows a framed "LolSuit mail" block
# with the link in it. That is the right default for development: the flow is
# fully demonstrable with no mail account anywhere.
MAIL_BACKEND=console

# To actually deliver mail, set MAIL_BACKEND=smtp and fill in the rest.
#
# Brevo (brevo.com) is the recommended relay: 300 emails/day free, no domain
# required, no credit card. Sign up, verify ONE sender address under
# "Senders & IPs" (a plain Gmail address is fine), then copy the login and key
# from "SMTP & API". MAIL_FROM must be that verified address; a display name in
# front of it is fine.
#
# MAIL_BACKEND=smtp
# MAIL_FROM=LolSuit <lol-suit-no-reply@gmail.com>
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=1
#
# Other relays are a swap of the host and the credentials, nothing else - the
# mail code speaks plain SMTP + STARTTLS on 587 either way:
#
#   Mailjet   SMTP_HOST=in-v3.mailjet.com    (200/day; API key + secret key)
#   Gmail     SMTP_HOST=smtp.gmail.com       (~500/day) - but it needs 2-Step
#             Verification on the account plus a 16-character App Password (the
#             ordinary account password fails with "535 Username and Password
#             not accepted"), it REWRITES the From header to the address you
#             authenticated as, and it sometimes blocks sign-ins coming from a
#             server in another country.
#
# Port 587 matters on EC2: AWS throttles outbound port 25 by default.
# The SMTP password is a credential. It belongs in .env (gitignored), never in
# docker-compose.yml and never in a commit.

# How long a reset link stays valid, and how long before a second one will be
# sent to the same account. Within the cooldown the endpoint still answers
# exactly the same - it just does not send - so nobody can use it to flood an
# inbox or burn through the relay's daily quota.
# RESET_TTL_MINUTES=30
# RESET_COOLDOWN_SECONDS=60
