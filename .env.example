# Copy to .env on the EC2 instance and fill in real values (never commit .env).
# Used by docker-compose.prod.yml.

# Amazon RDS connection (MySQL 8)
DB_HOST=your-db.xxxxxxxx.eu-central-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=replace-with-rds-master-password
DB_NAME=lolsuit

# App secret for signing auth tokens
JWT_SECRET=replace-with-a-long-random-string

# The bots' brain. With nothing here configured the app runs fully on the
# deterministic offline generator, so all of this is optional.
LLM_PROVIDER=bedrock
# Empty uses the provider's default model (see server/app/brain/llm.py):
# anthropic.claude-sonnet-5 on bedrock, claude-sonnet-5 on anthropic.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=10
# Set to 1 to force the offline generator even when a provider is configured.
BRAIN_FORCE_OFFLINE=0

# LLM_PROVIDER=bedrock - credentials come from the standard AWS chain
# (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, AWS_PROFILE, or the EC2/ECS role).
# Region is the one thing the SDK will not infer, and it is what switches the
# live backend on. Never commit real keys - prefer an instance role.
AWS_REGION=eu-central-1

# LLM_PROVIDER=anthropic - the direct API instead of Bedrock. Unused above.
LLM_API_KEY=
